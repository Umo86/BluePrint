# BluePrint settings. On your own computer you need none of these: everything runs locally.
# For a live site, set them in Vercel → Settings → Environment Variables (see docs/deployment.md).
# Never commit real values.

# The site's address, exactly as people type it.
APP_URL=https://blueprint.media10.co.uk

# Neon's pooled connection string (the host contains "-pooler"), ending ?sslmode=require
DATABASE_URL=

# 32 random bytes, base64: openssl rand -base64 32   (keep a copy in the password manager)
APP_ENCRYPTION_KEY=
# Only while changing the key: the old key (see docs/security.md)
# APP_ENCRYPTION_KEY_PREVIOUS=

# A long random value: openssl rand -hex 32   (Vercel sends it with each scheduled job)
CRON_SECRET=

# Email through Resend (docs/email.md)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DEFAULT_FROM="BluePrint <no-reply@mail.media10.co.uk>"

# Files in Cloudflare R2 (docs/deployment.md, step 3)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blueprint-files
# "eu" if the bucket was created with the EU jurisdiction
R2_JURISDICTION=eu

# Card payments and supplier payouts through Stripe (docs/payments.md). Leave empty until ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# The exhibitor assistant (docs/assistant.md). Without it the assistant is hidden.
ANTHROPIC_API_KEY=

# Only when creating the first super admin with `npm run bootstrap`
# BOOTSTRAP_SUPER_ADMIN_EMAIL=you@media10.co.uk
